# Локальные настройки сборки. Скопируй этот файл в .env и укажи свой путь.
# .env НЕ коммитится (он в .gitignore) — у каждого свой.

# Каталог, куда `./gradlew deploy` кладёт собранный jar — обычно папка plugins сервера.
# Windows-путь можно писать через прямые слэши.
DEPLOY_DIR=C:/Servers/your-server/plugins
